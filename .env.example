# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

DJANGO_SETTINGS_MODULE=config.settings.dev

# Whether settings read this file at all. True on a development machine. Docker
# Compose sets it False: the repo is bind-mounted there, so this file would
# otherwise fill in every key Compose does not set.
READ_DOT_ENV_FILE=True
SECRET_KEY=change-me-to-50-random-characters
DEBUG=True

# Comma-separated.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Absolute base for canonicals, magic links and sitemap entries.
SITE_BASE_URL=http://localhost:8000

# PostGIS, not plain Postgres. The database needs the postgis and pg_trgm
# extensions — see README.md.
DATABASE_URL=postgis://postgres:postgres@localhost:5432/kiam_directory
REDIS_URL=redis://localhost:6379/0

# GeoDjango library paths. Needed on macOS/Homebrew, where /opt/homebrew/lib is
# not on the default linker search path. Leave blank on Debian/Ubuntu.
GDAL_LIBRARY_PATH=
GEOS_LIBRARY_PATH=

# Magic links.
MAGIC_LINK_TTL_MINUTES=15
MAGIC_LINK_MAX_PER_EMAIL=5
MAGIC_LINK_MAX_PER_IP=20
MAGIC_LINK_WINDOW_SECONDS=3600

# Where the Django admin is mounted. Not /admin/.
ADMIN_URL_PATH=staff-console

# Email. The console backend prints the magic link to the terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Kiam Clinic Directory <no-reply@kiamclinic.com>

# Object storage (production only). TWO buckets, never one with two prefixes —
# see directory/storages.py.
PUBLIC_MEDIA_BUCKET=
PRIVATE_EVIDENCE_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
PRIVATE_DOCUMENT_URL_TTL_SECONDS=300

# Sentry. Unset = no-op.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_ENVIRONMENT=development

LOG_LEVEL=INFO
